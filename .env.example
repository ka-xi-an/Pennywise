# Database. SQLite for local development; for production use PostgreSQL:
#   1. change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma
#   2. DATABASE_URL="postgresql://user:password@host:5432/ledgerline?sslmode=require"
DATABASE_URL="file:./prisma/dev.db"

# 32-byte key (64 hex chars) used to encrypt uploaded files (receipts, tax documents) at rest
# with AES-256-GCM. `npm run setup` generates one. Losing it makes stored files unreadable.
FILE_ENCRYPTION_KEY=""

# Directory for encrypted uploads (outside the web root).
STORAGE_DIR="./storage"

# Optional: enables the Claude-powered natural-language analyst. Without it the
# AI Financial Analyst uses the built-in deterministic engine only. Server-side only.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Optional: market data provider. No provider ships enabled; prices are entered
# manually and labelled with their date. See docs/ARCHITECTURE.md#market-data.
MARKET_DATA_PROVIDER=""
